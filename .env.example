# ==============================================================================
# DevCommand Configuration & Environment Variables
# ==============================================================================

# Core Security & JWT
SECRET_KEY=devcommand_super_secret_jwt_key_replace_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet Key for AES-256 Encryption of User GitHub Tokens
# Generate in python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FERNET_ENCRYPTION_KEY=dGhpcy1pcy1hLWR1bW15LWtleS1mb3ItZGV2LWV4YW1wbGUtMTIzNDU=

# Database Configuration
# MongoDB Atlas:
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=devcommand

# SQL Fallback (SQLite / PostgreSQL):
DATABASE_URL=sqlite:///./devcommand.db

# GitHub OAuth App (Optional - for GitHub Login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://smart-project-manager1.vercel.app/auth/github/callback

# Multi-Tier AI Cascade Engine
# Tier 1: OpenRouter (Free models: meta-llama/llama-3.3-70b-instruct:free, etc.)
OPENROUTER_API_KEY=
# Tier 2: Google Gemini (Free tier: gemini-2.5-flash / gemini-1.5-flash)
GEMINI_API_KEY=
# Tier 3: NVIDIA NIM API (Free developer inference tier)
NVIDIA_API_KEY=

# App URLs
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://10.0.2.2:8000","https://smart-project-manager1.vercel.app","https://smart-project-manager-em2i.onrender.com"]
NEXT_PUBLIC_API_URL=https://smart-project-manager-em2i.onrender.com/api/v1
